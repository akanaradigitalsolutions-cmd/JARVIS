#!/bin/bash
# The actual executable inside JARVIS.app's bundle — this is what macOS
# runs when you double-click the app, or when something (a keyboard
# shortcut, `open -a JARVIS`) launches it. Never opens a Terminal window.
#
# If your JARVIS project lives somewhere other than ~/JARVIS, either set
# JARVIS_PROJECT_DIR in your shell environment before launching, or just
# edit the default below.
set -e

JARVIS_DIR="${JARVIS_PROJECT_DIR:-$HOME/JARVIS}"
LOG_DIR="$HOME/.jarvis/logs"
mkdir -p "$LOG_DIR"

if [ ! -d "$JARVIS_DIR" ] || [ ! -f "$JARVIS_DIR/.venv/bin/activate" ]; then
    osascript -e "display alert \"JARVIS not found\" message \"Couldn't find a JARVIS install with its virtual environment at $JARVIS_DIR. Edit Contents/MacOS/JARVIS inside JARVIS.app (right-click JARVIS.app > Show Package Contents) and fix JARVIS_DIR, or set the JARVIS_PROJECT_DIR environment variable.\" as critical"
    exit 1
fi

cd "$JARVIS_DIR"
# shellcheck disable=SC1091
source .venv/bin/activate

# python.org's official installer ships a universal2 (x86_64 + arm64) fat
# binary. Launched from an interactive Terminal it runs arm64 natively as
# expected, but launched via this GUI app bundle it was picking the x86_64
# slice instead (confirmed: dlopen failures on arm64-only compiled wheels
# like pydantic_core, even though `uname -m`/`arch` both report arm64 and
# nothing is running under Rosetta translation) — some quirk of how
# LaunchServices execs a fat binary vs. an interactive shell does. Rather
# than rely on detecting that, just force the correct slice directly.
#
# `arch -arm64 jarvis` isn't enough: `jarvis` is a shebang script, and the
# kernel's shebang handling re-execs the interpreter path itself — that
# internal re-exec doesn't inherit arch's binary-architecture preference,
# so the interpreter still ends up x86_64 when launched via a real Finder
# double-click (as opposed to `open -a` from an already-arm64 Terminal).
# Point arch at the python3.13 binary directly instead, passing the
# jarvis script as a plain argument, so there's no re-exec hop for the
# preference to get lost on.
if [ "$(uname -m)" = "arm64" ]; then
    exec arch -arm64 "$JARVIS_DIR/.venv/bin/python3.13" "$JARVIS_DIR/.venv/bin/jarvis" --ui >> "$LOG_DIR/launcher.log" 2>&1
else
    exec jarvis --ui >> "$LOG_DIR/launcher.log" 2>&1
fi
