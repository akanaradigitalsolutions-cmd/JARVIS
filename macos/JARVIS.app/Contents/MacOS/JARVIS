#!/bin/bash
# The actual executable inside JARVIS.app's bundle — this is what macOS
# runs when you double-click the app, or when something (a keyboard
# shortcut, `open -a JARVIS`) launches it. Never opens a Terminal window.
#
# If your JARVIS project lives somewhere other than ~/JARVIS, either set
# JARVIS_PROJECT_DIR in your shell environment before launching, or just
# edit the default below.
#
# No `set -e` on purpose — the diagnostics block runs probe commands that
# are allowed to fail (e.g. asking a slice that isn't there to run).

JARVIS_DIR="${JARVIS_PROJECT_DIR:-$HOME/JARVIS}"
LOG_DIR="$HOME/.jarvis/logs"
mkdir -p "$LOG_DIR"
DIAG="$LOG_DIR/launcher.log"

if [ ! -d "$JARVIS_DIR" ] || [ ! -f "$JARVIS_DIR/.venv/bin/activate" ]; then
    osascript -e "display alert \"JARVIS not found\" message \"Couldn't find a JARVIS install with its virtual environment at $JARVIS_DIR. Edit Contents/MacOS/JARVIS inside JARVIS.app (right-click JARVIS.app > Show Package Contents) and fix JARVIS_DIR, or set the JARVIS_PROJECT_DIR environment variable.\" as critical"
    exit 1
fi

cd "$JARVIS_DIR"
# shellcheck disable=SC1091
source .venv/bin/activate

# Resolve the venv's Python (the interpreter name can vary a little).
PYBIN="$JARVIS_DIR/.venv/bin/python3.13"
[ -x "$PYBIN" ] || PYBIN="$JARVIS_DIR/.venv/bin/python3"
[ -x "$PYBIN" ] || PYBIN="$JARVIS_DIR/.venv/bin/python"

# Why this dance (all confirmed empirically via the diagnostics block on a
# real Finder launch of this bundle):
#
#   uname -m            : x86_64   <- a Finder double-click starts this
#   proc_translated     : 1           whole bundle *translated* under
#   arch -arm64 reports : arm64        Rosetta on Apple Silicon
#
# Two consequences:
#   1. `uname -m` is USELESS for detecting the machine here — under Rosetta
#      it reports x86_64, not the real arm64 hardware. (Earlier versions of
#      this script gated the fix on `uname -m = arm64`, which is false in
#      this context, so the fix silently never ran.) The reliable host
#      probe that Rosetta doesn't mask is `sysctl hw.optional.arm64`.
#   2. The venv Python is a universal2 fat binary; its DEFAULT slice under
#      a translated parent is x86_64, which then can't dlopen the
#      arm64-only pydantic_core wheel. But `arch -arm64` successfully forces
#      the arm64 slice even from the translated shell — so on Apple Silicon
#      we always launch Python through `arch -arm64`.
{
    echo "=== JARVIS launcher diagnostics $(date '+%Y-%m-%d %H:%M:%S') ==="
    echo "uname -m            : $(uname -m)"
    echo "proc_translated     : $(sysctl -n sysctl.proc_translated 2>/dev/null || echo n/a)"
    echo "hw.optional.arm64   : $(sysctl -n hw.optional.arm64 2>/dev/null || echo n/a)"
    echo "PYBIN               : $PYBIN"
    echo "default slice       : $("$PYBIN" -c 'import platform; print(platform.machine())' 2>&1)"
    echo "arch -arm64 slice   : $(arch -arm64 "$PYBIN" -c 'import platform; print(platform.machine())' 2>&1)"
    echo "=========================================================="
} >> "$DIAG" 2>&1

# `-m jarvis.main` doesn't depend on the console-script path existing.
if [ "$(sysctl -n hw.optional.arm64 2>/dev/null)" = "1" ]; then
    exec arch -arm64 "$PYBIN" -m jarvis.main --ui >> "$DIAG" 2>&1
else
    exec "$PYBIN" -m jarvis.main --ui >> "$DIAG" 2>&1
fi
