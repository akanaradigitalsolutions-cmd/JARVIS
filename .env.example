# Copy this file to .env and fill in your values. .env is gitignored.
#
# JARVIS uses the `claude` CLI (Claude Code) as its brain, authenticated
# against your Claude Pro/Max subscription — NOT a separate API key. Before
# running JARVIS:
#   1. Install Claude Code:  npm install -g @anthropic-ai/claude-code
#   2. Log in:                claude login
#
# Do NOT set ANTHROPIC_API_KEY below (or anywhere in your shell environment)
# unless you specifically want to bill usage against pay-as-you-go API
# credits instead of your subscription — if it's set, the claude CLI will
# use it instead of your subscription login.

# Optional: path to the claude binary, if it's not on your PATH.
JARVIS_CLAUDE_BIN=claude

# Optional: which model Jarvis asks the claude CLI to use (alias like
# "sonnet" or a full model name). Defaults to claude-sonnet-5.
JARVIS_MODEL=claude-sonnet-5

# Optional: where Jarvis reads/writes files (created if it doesn't exist).
# Defaults to ~/Jarvis/workspace
JARVIS_WORKSPACE=

# Optional: just the display text shown to you for the wake phrase — voice
# mode always actually listens for "Hey JARVIS" (openWakeWord's pretrained
# model). Changing this string alone does NOT change what it listens for.
JARVIS_WAKE_WORD=hey jarvis

# Optional: absolute path to a custom-trained openWakeWord model file
# (.onnx or .tflite), if you've trained one for a custom phrase (e.g.
# "jarvis wake up") — see ARCHITECTURE.md#custom-wake-word. Leave blank to
# use the free pretrained "Hey JARVIS" model.
JARVIS_WAKE_WORD_MODEL=

# Optional: wake-word detection sensitivity, 0-1. Lower = easier to
# trigger (better for non-US accents/pronunciation) but more prone to
# false positives from background noise or unrelated speech. Default is
# already more lenient than openWakeWord's own suggested 0.5 — if "Hey
# JARVIS" still isn't triggering for you, try lowering this further
# (e.g. 0.2); if it's triggering on its own from background noise/TV/etc,
# raise it (e.g. 0.4-0.5).
JARVIS_WAKE_WORD_THRESHOLD=0.3

# Optional: TTS voice rate (words per minute), default 175
JARVIS_TTS_RATE=175

# Optional: force a specific TTS voice (substring match against a voice
# name/id — run `python -m jarvis.voice.tts --list-voices` to see what's
# available on your machine). Leave blank to auto-pick a British-accented
# voice if one exists (closer to JARVIS than the US English default),
# falling back to your OS default otherwise.
JARVIS_TTS_VOICE=
