# Copy this file to .env and fill in your values. .env is gitignored.

# Required: your Claude API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: which Claude model Jarvis uses as its brain.
JARVIS_MODEL=claude-sonnet-5

# Optional: where Jarvis reads/writes files (created if it doesn't exist).
# Defaults to ~/Jarvis/workspace
JARVIS_WORKSPACE=

# Optional: wake word phrase for voice mode (default: "jarvis")
JARVIS_WAKE_WORD=jarvis

# Optional: TTS voice rate (words per minute), default 175
JARVIS_TTS_RATE=175
